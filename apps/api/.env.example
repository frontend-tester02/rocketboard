# API (NestJS) environment
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/rocket

# Auth (JWT)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rocket
S3_REGION=us-east-1

# Mail (mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@rocket.local
